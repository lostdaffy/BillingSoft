# Copy this file to .env and fill in the values.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/ebillsoft

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Frontend URL(s) allowed to call the API, comma separated. Localhost is always
# allowed when NODE_ENV is not production.
CLIENT_URL=https://ebillsoft.netlify.app

# Timezone used for "today", overdue checks and financial year boundaries.
APP_TIMEZONE=Asia/Kolkata

# Upgrade v1 data and sync indexes on every start (idempotent). Set to false to
# run it manually with: npm run migrate
AUTO_MIGRATE=true

# Failed login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
